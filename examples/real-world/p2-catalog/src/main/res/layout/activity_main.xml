<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="16dp">
  <TextView android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Shop"
    android:textSize="24sp" />
  <Button android:id="@+id/product1_button"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Red shoes" />
  <Button android:id="@+id/product2_button"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Blue jacket" />
  <Button android:id="@+id/product3_button"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Green hat" />
  <Button android:id="@+id/product4_button"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Black bag" />
  <Button android:id="@+id/product5_button"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="White shirt" />
  <Button android:id="@+id/product6_button"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Yellow scarf" />
  <Button android:id="@+id/product7_button"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Brown boots" />
  <Button android:id="@+id/product8_button"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Grey gloves" />
  <Button android:id="@+id/cart_button"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Cart" />
</LinearLayout>
